# ==============================================================================
# CONFIGURACION DE ENTORNO: PLATAFORMA WEBGIS UAGRM (SUPABASE / POSTGIS)
# ==============================================================================
# Copia este archivo a '.env' y completa con los valores de tu panel de Supabase.

# 1. API DE SUPABASE (Project Settings -> API)
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...tu_clave_anonima_publica...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...tu_clave_de_servicio_backend...

# 2. CONEXION DIRECTA A POSTGRES / POSTGIS (Project Settings -> Database -> Connection String -> URI)
# Si te conectas por FastAPI / SQLAlchemy / asyncpg, usa el puerto 5432 o 6543 (Pooler)
# Formato: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:TU_PASSWORD_AQUI@db.TU_PROJECT_REF.supabase.co:5432/postgres

# 3. CONFIGURACION DEL SERVIDOR FASTAPI (Opcional / Por defecto)
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
ENVIRONMENT=development
