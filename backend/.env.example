# ==============================================================================
# CONFIGURACION DE ENTORNO: BACKEND FASTAPI - SIG POSTGRADOS UAGRM
# ==============================================================================
# Copia este archivo como '.env' en la carpeta backend/ o en la raiz del proyecto.

# 1. ORIGENES PERMITIDOS PARA CORS (separados por coma o '*' para todos)
CORS_ORIGINS=*

# 2. CONEXION A BASE DE DATOS POSTGRESQL / POSTGIS (SUPABASE)
# ------------------------------------------------------------------------------
# [!] NOTA CRITICA PARA DESPLIEGUE EN RENDER:
# Render corre sobre infraestructura de red con salida IPv4 para planes gratuitos.
# El host directo de Supabase ('db.TU_PROJECT_REF.supabase.co') resuelve exclusivamente
# por IPv6 en entornos modernos de Supabase, lo que causa un timeout de conexion en Render.
#
# Por tanto, para desplegar en Render DEBES usar la URL del Session Pooler IPv4 de Supabase:
# Panel de Supabase -> Project Settings -> Database -> Connection String -> URI -> pestaña "Connection pooling" -> Modo "Session"
# Puerto: 5432
# Host: aws-0-[REGION].pooler.supabase.com
#
# Formato requerido:
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# 3. PUERTO LOCAL (Utilizado al correr con python/uvicorn localmente)
PORT=8000
